# Must be the same Google OAuth 2.0 Web client ID configured in the frontend
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required for request and message notification emails. Use your SMTP provider's credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=SkillSwap <no-reply@example.com>
PUBLIC_APP_URL=https://your-frontend-domain.example
