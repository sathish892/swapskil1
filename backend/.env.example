# Must be the same Google OAuth 2.0 Web client ID configured in the frontend
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Preferred on Render Free: Brevo HTTPS API key. Register and verify EMAIL_FROM in Brevo.
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=SkillSwap <verified-sender@example.com>
PUBLIC_APP_URL=https://your-frontend-domain.example

# Optional SMTP fallback for hosts that allow outbound SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
